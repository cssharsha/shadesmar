package(default_visibility = ["//visibility:public"])

# JSON schemas
filegroup(
    name = "jsonschema",
    srcs = glob(["jsonschema/*.json"]),
)

# Protobuf schemas (for future use)
filegroup(
    name = "protobuf",
    srcs = glob(["proto/foxglove/*.proto"]),
)

# Flatbuffer schemas (for future use)
filegroup(
    name = "flatbuffer",
    srcs = glob(["flatbuffer/*.fbs"]),
)
